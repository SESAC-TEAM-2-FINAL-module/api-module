# ============================================================
# API 모듈 환경변수 — 값은 .env에, 이 파일은 변수명만 (커밋됨)
# ============================================================

# ── data.go.kr 조위관측소 API (1.1절) ──────────────────────
# 일반 인증키(Decoding), params= 로 전달
DTRECENT_KEY=
DTRECENT_URL=https://apis.data.go.kr/1192136/dtRecent/GetDTRecentApiService

# ── NIFS API 3종 (1.1절) ────────────────────────────────────
# nifs.go.kr 자체 키 — data.go.kr 키와 호환되지 않음
NIFS_KEY_BULLETIN=
NIFS_KEY_LINE=
NIFS_KEY_FISHERY_SEA=
NIFS_URL=https://www.nifs.go.kr/OpenAPI_json

# ── DB 연결 (5.4절) — 한 줄만 주석 해제 ─────────────────────
# PostgreSQL 16
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aquasentinel
# TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aquasentinel_test

# MySQL 8.0
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aquasentinel
# TEST_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aquasentinel_test

# --- (선택) 두 DB 비교 검사용 — 다른 쪽 DB (7.4절) ---
# TEST_DATABASE_URL_ALT=

# ── 운영 조정 (2.0.6절) ─────────────────────────────────────
# ConfigMap의 로컬 대용 — 결정된 값만 담아야 함, <미결> 있으면 기동 검사에서 멈춤
OPERATIONAL_CONFIG_PATH=
