{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "queue-v2",
  "description": "단계 간 알림 메시지 스키마 (2.2절, 개정 22) — interp.done.error_p95 널 허용 추가",
  "definitions": {
    "raw_fetched": {
      "type": "object",
      "required": ["schema", "topic", "raw_id", "api", "tag", "fetched_at_utc"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "raw.fetched"},
        "raw_id": {"type": "string"},
        "api": {"type": "string"},
        "tag": {"type": "string"},
        "fetched_at_utc": {"type": "string"}
      }
    },
    "obs_loaded": {
      "type": "object",
      "required": ["schema", "topic", "load_id", "api", "source", "station_ids", "observed_from_utc", "observed_to_utc", "row_count"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "obs.loaded"},
        "load_id": {"type": "string"},
        "api": {"type": "string"},
        "source": {"type": "string", "enum": ["tide", "bulletin", "line", "fishery"]},
        "station_ids": {"type": "array", "items": {"type": "string"}},
        "observed_from_utc": {"type": "string"},
        "observed_to_utc": {"type": "string"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
    "interp_done": {
      "type": "object",
      "required": ["schema", "topic", "run_id", "load_id", "farm_count", "metric", "stations_used"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "interp.done"},
        "run_id": {"type": "string"},
        "load_id": {"type": "string"},
        "farm_count": {"type": "integer", "minimum": 0},
        "metric": {"type": "string"},
        "error_p95": {"type": ["number", "null"]},
        "stations_used": {"type": "integer", "minimum": 0}
      }
    },
    "grade_done": {
      "type": "object",
      "required": ["schema", "topic", "grade_run_id", "axis", "farm_ids"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "grade.done"},
        "grade_run_id": {"type": "string"},
        "axis": {"type": "string"},
        "farm_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "result_updated": {
      "type": "object",
      "required": ["schema", "topic", "farm_ids", "axes", "updated_at_utc"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "result.updated"},
        "farm_ids": {"type": "array", "items": {"type": "string"}},
        "axes": {"type": "array", "items": {"type": "string"}},
        "updated_at_utc": {"type": "string"}
      }
    },
    "completeness_collected": {
      "type": "object",
      "description": "분할 합산 완료 알림 (계획서 2.2·3.3절, 개정 17) — 받은 것만, 건수·판정 없음",
      "required": ["schema", "topic", "run_key", "api", "window_start", "window_end", "single_raw_id", "parts"],
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string", "const": "queue-v2"},
        "topic": {"type": "string", "const": "completeness.collected"},
        "run_key": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}$"},
        "api": {"type": "string", "enum": ["redtideList", "sooList", "femoSeaList"]},
        "window_start": {"type": "string", "pattern": "^[0-9]{8}$"},
        "window_end": {"type": "string", "pattern": "^[0-9]{8}$"},
        "single_raw_id": {"type": "string"},
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "end", "raw_id"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "string", "pattern": "^[0-9]{8}$"},
              "end": {"type": "string", "pattern": "^[0-9]{8}$"},
              "raw_id": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
